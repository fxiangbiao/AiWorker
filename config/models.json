{
  "default": {
    "provider": "openai",
    "model": "Qwen3.6-35B-A3B-UD-IQ3_S",
    "baseURL": "http://localhost:8000/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "temperature": 0.7,
    "maxTokens": 4096
  },
  "profiles": {
    "coding": {
      "model": "gpt-4o",
      "temperature": 0.2
    },
    "reasoning": {
      "model": "o3-mini",
      "temperature": 0.3
    },
    "writing": {
      "model": "gpt-4o-mini",
      "temperature": 0.8
    },
    "creative": {
      "model": "gpt-4o",
      "temperature": 0.9
    },
    "lite": {
      "model": "gpt-4o-mini",
      "temperature": 0.5
    }
  },
  "routing": {
    "strategy": "profile-based",
    "fallback": "default"
  }
}
