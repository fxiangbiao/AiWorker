{
  "default": {
    "provider": "openai",
    "model": "Qwen3.6-35B-A3B-UD-IQ3_S",
    "baseURL": "http://localhost:8000/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "temperature": 0.7,
    "maxTokens": 4096
