{
  "default_mode": "auto",
  "modes": {
    "ask": {
      "description": "只读问答，仅执行只读工具（读取/搜索）",
      "allow_tool_calls": true,
      "readOnly": true
    },
    "plan": {
      "description": "先列计划，用户确认后再执行",
      "allow_tool_calls": false,
      "require_confirmation": true
    },
    "auto": {
      "description": "自主执行，高危操作仍需确认",
      "allow_tool_calls": true,
      "high_risk_confirm": true
    }
  },
  "allowed_dirs": [],
  "denied_patterns": [
    "rm -rf /",
    "rm -rf ~",
    "DROP TABLE",
    "DROP DATABASE",
    "git push --force",
    "git reset --hard",
    "format C:",
    "shutdown",
    "reboot"
  ],
  "rules": [],
  "never_auto_approve": [
    "spawn_agent",
    "send_message"
  ],
  "protected_paths": [
    ".git",
    ".ssh",
    ".aws",
    ".kube",
    ".claude",
    ".npmrc",
    ".env",
    ".envrc",
    "id_rsa"
  ]
}
