{
  "name": "aiworker",
  "version": "0.6.5",
  "description": "AiWorker - 涓汉 AI Agent 鍔╂墜锛屽鏅鸿兘浣撳崗浣?+ MCP + Skills + Hooks",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aiworker": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation tsx src/index.ts",
    "web:dev": "cd web && npx vite --port 5173",
    "web:build": "cd web && npx vite build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation node dist/index.js",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-deprecation vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "cron-parser": "^5.10.0",
    "inquirer": "^12.3.0",
    "openai": "^4.77.0",
    "ws": "^8.21.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  }
}
