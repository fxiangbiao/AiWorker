{
  "default": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "baseURL": "https://api.deepseek.com",
    "apiKey": "${DEEPSEEK_API_KEY}",
    "thinking": true,
    "adapter": "openai-compatible"
  },
  "pricing": {
    "deepseek": { "prompt": 1, "completion": 2 }
  },
  "profiles": {
    "coding": { "temperature": 0.2 },
    "reasoning": { "temperature": 0.3 },
    "writing": { "temperature": 0.8 },
    "creative": { "temperature": 0.9 },
    "lite": {
      "provider": "openai",
      "model": "Qwen3.8-27B-UD-IQ2_XXS",
      "baseURL": "http://localhost:8000/v1",
      "apiKey": "${OPENAI_API_KEY}",
      "temperature": 0.5,
      "maxTokens": 4096
    }
  },
  "routing": {
    "strategy": "profile-based",
    "fallback": "default"
  }
}
